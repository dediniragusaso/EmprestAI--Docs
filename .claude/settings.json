{
  "permissions": {
    "deny": [
      "Bash(prisma migrate deploy*)",
      "Bash(npx prisma migrate deploy*)",
      "Bash(prisma db push*)",
      "Bash(npx prisma db push*)",
      "Bash(supabase db push*)",
      "Bash(npx supabase db push*)",
      "Read(./.env)",
      "Read(./back/.env)",
      "Read(./front/.env)",
      "Read(./back/.env.remote)",
      "Read(**/.env)",
      "Read(**/.env.remote)",
      "Read(**/.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/exige-verificacao.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/exige-verificacao.mjs\""
          }
        ]
      }
    ]
  }
}
