# ============================================================
# EMPREST.AI - .env unico do projeto (raiz)
# Uso local. O template versionavel e o .env.example.
# Convencao: API sem prefixo; front com VITE_ (o Vite so expoe
# para o cliente o que tem prefixo VITE_)
# ============================================================

# ---------- Geral ----------
NODE_ENV=development

# ---------- API (NestJS + Prisma + Supabase) ----------
PORT=3000

# Banco - runtime: Supavisor (pooler), porta 6543, pgbouncer
DATABASE_URL="postgresql://postgres.<project-ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Banco - migrations: conexao direta, porta 5432 (Prisma directUrl)
DIRECT_URL="postgresql://postgres:<senha>@db.<project-ref>.supabase.co:5432/postgres"

# Auth - Nest valida o JWT via JWKS do Supabase
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"
# Fallback legado (HS256), se o projeto usar segredo simetrico:
# SUPABASE_JWT_SECRET=

# CORS - origem do front (allowlist; multiplas separadas por virgula)
CORS_ORIGIN="http://localhost:5173"

# ---------- Front (Vite + React) ----------
# Base da API (rota com prefixo /v1)
VITE_API_URL="http://localhost:3000/v1"
# Supabase: somente login/sessao via supabase-js; dados SEMPRE via API
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key>"
