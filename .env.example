# ============================================================
# EMPREST.AI - .env unico do projeto (raiz)
# Uso local. O template versionavel e o .env.example.
# Desenvolvimento no banco LOCAL do Supabase CLI (supabase start):
# banco em localhost:54322, Auth em localhost:54321.
# Convencao: API sem prefixo; front com VITE_ (o Vite so expoe
# para o cliente o que tem prefixo VITE_)
# ============================================================

# ---------- Geral ----------
NODE_ENV=development

# ---------- API (NestJS + Prisma + Supabase local) ----------
PORT=3000

# Banco local - runtime (Prisma) - senha padrao do supabase start: postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
# Banco local - migrations (Prisma directUrl, mesma porta direta)
DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Auth local - Nest valida o JWT via JWKS do Supabase
SUPABASE_URL="http://localhost:54321"
SUPABASE_JWKS_URL="http://localhost:54321/auth/v1/.well-known/jwks.json"

# CORS - origem do front (allowlist; multiplas separadas por virgula)
CORS_ORIGIN="http://localhost:5173"

# ---------- Front (Vite + React) ----------
# Base da API (rota com prefixo /v1)
VITE_API_URL="http://localhost:3000/v1"
# Supabase local: somente login/sessao via supabase-js; dados SEMPRE via API.
# Anon key local: pegue com 'supabase status' apos subir o banco.
VITE_SUPABASE_URL="http://localhost:54321"
VITE_SUPABASE_ANON_KEY="<anon-key-do-supabase-start>"
